# Server-only values. Configure separate values for Development, Preview,
# and Production in Vercel. Never prefix these secrets with NEXT_PUBLIC_.
DATABASE_URL="postgresql://app_user:replace-me@localhost:5432/enterprise_platform"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# Optional comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# Usually supplied automatically by the runtime.
NODE_ENV="development"
# VERCEL_ENV="preview"
